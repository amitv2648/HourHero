{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid == $uid"
      }
    },
    "organizations": {
      "$orgId": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid == $orgId",
        "opportunities": {
          ".read": "auth != null",
          ".write": "auth != null && auth.uid == $orgId"
        }
      }
    },
    "opportunities": {
      ".read": "auth != null",
      "$oppId": {
        ".read": "auth != null",
        ".write": "auth != null && (data.child('org_id').val() == auth.uid || (!data.exists() && newData.child('org_id').val() == auth.uid))",
        "participants": {
          "$volId": {
            ".read": "auth != null",
            ".write": "auth != null && $volId == auth.uid"
          }
        }
      }
    },
    "submissions": {
      ".read": "auth != null",
      "$subId": {
        ".write": "auth != null && (newData.child('volunteer_id').val() == auth.uid || data.child('org_id').val() == auth.uid)"
      }
    }
  }
}
