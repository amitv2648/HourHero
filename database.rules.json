{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid == $uid",
        "total_hours": {
          ".write": "auth != null && (auth.uid == $uid || root.child('organizations').child(auth.uid).exists())"
        },
        "pending_count": {
          ".write": "auth != null && (auth.uid == $uid || root.child('organizations').child(auth.uid).exists())"
        },
        "joined_opportunities": {
          "$oppId": {
            ".write": "auth != null && (auth.uid == $uid || root.child('opportunities').child($oppId).child('org_id').val() == auth.uid)"
          }
        }
      }
    },
    "organizations": {
      "$orgId": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid == $orgId",
        "opportunities": {
          ".read": "auth != null",
          ".write": "auth != null && auth.uid == $orgId"
        }
      }
    },
    "opportunities": {
      ".read": "auth != null",
      "$oppId": {
        ".read": "auth != null",
        ".write": "auth != null && (data.child('org_id').val() == auth.uid || (!data.exists() && newData.child('org_id').val() == auth.uid))",
        "participants": {
          "$volId": {
            ".read": "auth != null",
            ".write": "auth != null && $volId == auth.uid"
          }
        }
      }
    },
    "submissions": {
      ".read": "auth != null",
      "$subId": {
        ".write": "auth != null && ((!data.exists() && newData.child('volunteer_id').val() == auth.uid) || (data.exists() && data.child('org_id').val() == auth.uid) || root.child('submissions').child($subId).child('org_id').val() == auth.uid)",
        "status": {
          ".write": "auth != null && root.child('submissions').child($subId).child('org_id').val() == auth.uid"
        },
        "reviewed_at": {
          ".write": "auth != null && root.child('submissions').child($subId).child('org_id').val() == auth.uid"
        },
        "rejection_note": {
          ".write": "auth != null && root.child('submissions').child($subId).child('org_id').val() == auth.uid"
        }
      }
    }
  }
}
