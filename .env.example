# Copy this file to .env and paste your FREE Google Gemini API key there.
# Get one at: https://aistudio.google.com/apikey
#
# IMPORTANT: Put your real key in .env — the server does NOT use .env.example
# unless .env is missing (fallback only). .env is gitignored and safe for secrets.

GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash
PORT=3000

# Optional — email when an org deletes an opportunity (volunteer notifications)
# Gmail example: use an App Password (https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=HourHero <your-email@gmail.com>
